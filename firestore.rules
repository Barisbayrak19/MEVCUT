rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function currentUser() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      );
    }

    function isAdmin() {
      return signedIn()
        && currentUser().data.role == "admin"
        && currentUser().data.active == true;
    }

    function isTeacher() {
      return signedIn()
        && currentUser().data.role == "teacher"
        && currentUser().data.active == true;
    }

    function isParent() {
      return signedIn()
        && currentUser().data.role == "parent"
        && currentUser().data.active == true;
    }

    function canManageSchool() {
      return isAdmin() || isTeacher();
    }

    function sameOrg(data) {
      return canManageSchool()
        && data.organizationId ==
           currentUser().data.organizationId;
    }

    function adminSameOrg(data) {
      return isAdmin()
        && data.organizationId ==
           currentUser().data.organizationId;
    }

    function isParentOfStudent(studentId) {
      return isParent()
        && exists(
          /databases/$(database)/documents/parentStudents/$(request.auth.uid + "_" + studentId)
        )
        && get(
          /databases/$(database)/documents/parentStudents/$(request.auth.uid + "_" + studentId)
        ).data.organizationId ==
           currentUser().data.organizationId
        && get(
          /databases/$(database)/documents/parentStudents/$(request.auth.uid + "_" + studentId)
        ).data.active == true;
    }


    match /users/{uid} {
      allow read:
        if signedIn()
        && (
          request.auth.uid == uid
          || isAdmin()
        );

      allow create:
        if isAdmin()
        || (
          signedIn()
          && request.auth.uid == uid
          && request.resource.data.role == "teacher"
          && request.resource.data.active == true
        );

      allow update:
        if isAdmin()
        || (
          signedIn()
          && request.auth.uid == uid
          && request.resource.data.role ==
             resource.data.role
          && request.resource.data.organizationId ==
             resource.data.organizationId
        );

      allow delete:
        if isAdmin();
    }


    match /classes/{classId} {
      allow read:
        if sameOrg(resource.data);

      allow create, update:
        if adminSameOrg(request.resource.data);

      allow delete:
        if adminSameOrg(resource.data);
    }


    match /students/{studentId} {
      allow read:
        if sameOrg(resource.data)
        || isParentOfStudent(studentId);

      allow create, update:
        if adminSameOrg(request.resource.data);

      allow delete:
        if adminSameOrg(resource.data);
    }


    match /parentStudents/{relationshipId} {
      allow read:
        if isAdmin()
        || (
          isParent()
          && resource.data.parentUid == request.auth.uid
        );

      allow create, update, delete:
        if adminSameOrg(
          request.resource.data
        );
    }


    match /teacherAssignments/{assignmentId} {
      allow read:
        if sameOrg(resource.data);

      allow create, update:
        if adminSameOrg(request.resource.data);

      allow delete:
        if adminSameOrg(resource.data);
    }


    match /schedules/{scheduleId} {
      allow read:
        if sameOrg(resource.data);

      allow create, update:
        if adminSameOrg(request.resource.data);

      allow delete:
        if adminSameOrg(resource.data);
    }


    match /attendance/{attendanceId} {
      allow get, list:
        if sameOrg(resource.data);

      allow create:
        if sameOrg(request.resource.data)
        && request.resource.data.reviewStatus != "approved";

      allow update:
        if (
          adminSameOrg(request.resource.data)
        )
        || (
          sameOrg(request.resource.data)
          && resource.data.reviewStatus != "approved"
          && request.resource.data.reviewStatus != "approved"
        );

      allow delete:
        if adminSameOrg(resource.data);
    }


    match /attendanceLogs/{logId} {
      allow read:
        if sameOrg(resource.data);

      allow create:
        if sameOrg(request.resource.data);

      allow update, delete:
        if adminSameOrg(resource.data);
    }


    match /attendanceReviews/{reviewId} {
      allow read:
        if sameOrg(resource.data);

      allow create:
        if adminSameOrg(request.resource.data);

      allow update, delete:
        if adminSameOrg(resource.data);
    }


    match /eokulQueue/{queueId} {
      allow read:
        if isAdmin()
        && resource.data.organizationId ==
           currentUser().data.organizationId;

      allow create:
        if adminSameOrg(request.resource.data);

      allow update:
        if adminSameOrg(request.resource.data);

      allow delete:
        if adminSameOrg(resource.data);
    }


    match /{document=**} {
      allow read, write: if false;
    }
  }
}
