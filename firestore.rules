rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function currentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return signedIn()
        && currentUser().data.role == "admin"
        && currentUser().data.active == true;
    }

    function canManageSchool() {
      return signedIn()
        && currentUser().data.active == true
        && (
          currentUser().data.role == "admin"
          || currentUser().data.role == "teacher"
        );
    }

    function sameOrg(data) {
      return canManageSchool() && data.organizationId == currentUser().data.organizationId;
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if isAdmin()
        || (
          signedIn()
          && request.auth.uid == uid
          && request.resource.data.role == "teacher"
          && request.resource.data.active == true
        );
      allow update: if isAdmin()
        || (
          signedIn()
          && request.auth.uid == uid
          && request.resource.data.role == resource.data.role
          && request.resource.data.organizationId == resource.data.organizationId
        );
      allow delete: if isAdmin();
    }

    match /classes/{classId} {
      allow read: if sameOrg(resource.data);
      allow create, update: if sameOrg(request.resource.data);
      allow delete: if sameOrg(request.resource.data);
    }

    match /students/{studentId} {
      allow read: if sameOrg(resource.data);
      allow create, update: if isAdmin() && sameOrg(request.resource.data);
      allow delete: if isAdmin() && sameOrg(resource.data);
    }

    match /attendance/{attendanceId} {
      allow read: if sameOrg(resource.data);
      allow create, update: if sameOrg(request.resource.data);
      allow delete: if isAdmin() && sameOrg(resource.data);
    }

    match / {document=**} {
      allow read, write: if false;
    }
  }
}
