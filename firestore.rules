rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function currentUser() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      );
    }

    function isAdmin() {
      return signedIn()
        && currentUser().data.role == "admin"
        && currentUser().data.active == true;
    }

    function isTeacher() {
      return signedIn()
        && currentUser().data.role == "teacher"
        && currentUser().data.active == true;
    }

    function isParent() {
      return signedIn()
        && currentUser().data.role == "parent"
        && currentUser().data.active == true;
    }

    function canManageSchool() {
      return isAdmin() || isTeacher();
    }

    function sameOrg(data) {
      return canManageSchool()
        && data.organizationId ==
           currentUser().data.organizationId;
    }

    function adminSameOrg(data) {
      return isAdmin()
        && data.organizationId ==
           currentUser().data.organizationId;
    }

    function teacherHasSubjectAccess(data) {
      return isTeacher()
        && exists(
          /databases/$(database)/documents/teacherAssignmentAccess/$(request.auth.uid + "__" + data.classCode)
        )
        && get(
          /databases/$(database)/documents/teacherAssignmentAccess/$(request.auth.uid + "__" + data.classCode)
        ).data.organizationId ==
           currentUser().data.organizationId
        && get(
          /databases/$(database)/documents/teacherAssignmentAccess/$(request.auth.uid + "__" + data.classCode)
        ).data.active == true
        && get(
          /databases/$(database)/documents/teacherAssignmentAccess/$(request.auth.uid + "__" + data.classCode)
        ).data.subjectCodes.hasAny([data.subjectCode]);
    }

    function teacherOwnAttendance(data) {
      return isTeacher()
        && data.organizationId == currentUser().data.organizationId
        && data.teacherUid == request.auth.uid;
    }

    function teacherCanWriteAttendance(data) {
      return teacherHasSubjectAccess(data)
        && data.teacherUid == request.auth.uid;
    }

    function isParentOfStudent(studentId) {
      return isParent()
        && exists(
          /databases/$(database)/documents/parentStudents/$(request.auth.uid + "_" + studentId)
        )
        && get(
          /databases/$(database)/documents/parentStudents/$(request.auth.uid + "_" + studentId)
        ).data.organizationId ==
           currentUser().data.organizationId
        && get(
          /databases/$(database)/documents/parentStudents/$(request.auth.uid + "_" + studentId)
        ).data.active == true;
    }


    match /users/{uid} {
      allow read:
        if signedIn()
        && (
          request.auth.uid == uid
          || isAdmin()
        );

      allow create:
        if isAdmin()
        || (
          signedIn()
          && request.auth.uid == uid
          && request.resource.data.role == "teacher"
          && request.resource.data.active == true
        );

      allow update:
        if isAdmin()
        || (
          signedIn()
          && request.auth.uid == uid
          && request.resource.data.role ==
             resource.data.role
          && request.resource.data.organizationId ==
             resource.data.organizationId
        );

      allow delete:
        if isAdmin();
    }


    match /classes/{classId} {
      allow read:
        if sameOrg(resource.data);

      allow create, update:
        if adminSameOrg(request.resource.data);

      allow delete:
        if adminSameOrg(resource.data);
    }


    match /students/{studentId} {
      allow read:
        if sameOrg(resource.data)
        || isParentOfStudent(studentId);

      allow create, update:
        if adminSameOrg(request.resource.data);

      allow delete:
        if adminSameOrg(resource.data);
    }


    match /parentStudents/{relationshipId} {
      allow read:
        if isAdmin()
        || (
          isParent()
          && resource.data.parentUid == request.auth.uid
        );

      allow create, update:
        if adminSameOrg(
          request.resource.data
        );

      allow delete:
        if adminSameOrg(resource.data);
    }


    match /teacherAssignments/{assignmentId} {
      allow read:
        if adminSameOrg(resource.data)
        || (
          isTeacher()
          && resource.data.organizationId == currentUser().data.organizationId
          && resource.data.teacherName == currentUser().data.displayName
        );

      allow create, update:
        if adminSameOrg(request.resource.data);

      allow delete:
        if adminSameOrg(resource.data);
    }


    match /teacherAssignmentAccess/{accessId} {
      allow read:
        if adminSameOrg(resource.data)
        || (
          isTeacher()
          && resource.data.organizationId == currentUser().data.organizationId
          && resource.data.teacherUid == request.auth.uid
        );

      allow create, update, delete:
        if adminSameOrg(
          request.resource.data
        );
    }


    match /schedules/{scheduleId} {
      allow read:
        if sameOrg(resource.data);

      allow create, update:
        if adminSameOrg(request.resource.data);

      allow delete:
        if adminSameOrg(resource.data);
    }


    match /attendance/{attendanceId} {
      allow get:
        if adminSameOrg(resource.data)
        || (
          teacherOwnAttendance(resource.data)
        )
        || (
          isTeacher()
          && resource.data.organizationId == currentUser().data.organizationId
          && resource.data.teacherUid == request.auth.uid
          && resource.data.subjectCode == "legacy"
        );

      allow list:
        if adminSameOrg(resource.data)
        || (
          teacherOwnAttendance(resource.data)
        )
        || (
          isTeacher()
          && resource.data.organizationId == currentUser().data.organizationId
          && resource.data.teacherUid == request.auth.uid
          && resource.data.subjectCode == "legacy"
        );

      allow create:
        if adminSameOrg(request.resource.data)
        || (
          teacherCanWriteAttendance(request.resource.data)
          && request.resource.data.reviewStatus != "approved"
        )
        || (
          isTeacher()
          && request.resource.data.organizationId == currentUser().data.organizationId
          && request.resource.data.teacherUid == request.auth.uid
          && request.resource.data.subjectCode == "legacy"
          && request.resource.data.reviewStatus != "approved"
        );

      allow update:
        if adminSameOrg(request.resource.data)
        || (
          teacherCanWriteAttendance(request.resource.data)
          && resource.data.reviewStatus != "approved"
          && request.resource.data.reviewStatus != "approved"
        )
        || (
          isTeacher()
          && request.resource.data.organizationId == currentUser().data.organizationId
          && request.resource.data.teacherUid == request.auth.uid
          && request.resource.data.subjectCode == "legacy"
          && resource.data.reviewStatus != "approved"
          && request.resource.data.reviewStatus != "approved"
        );

      allow delete:
        if adminSameOrg(resource.data);
    }


    match /attendanceLogs/{logId} {
      allow read:
        if adminSameOrg(resource.data)
        || (
          isTeacher()
          && resource.data.organizationId == currentUser().data.organizationId
          && resource.data.changedBy == request.auth.uid
        );

      allow create:
        if adminSameOrg(request.resource.data)
        || (
          isTeacher()
          && request.resource.data.organizationId == currentUser().data.organizationId
          && request.resource.data.changedBy == request.auth.uid
        );

      allow update, delete:
        if adminSameOrg(resource.data);
    }


    match /attendanceReviews/{reviewId} {
      allow read:
        if sameOrg(resource.data);

      allow create:
        if adminSameOrg(request.resource.data);

      allow update, delete:
        if adminSameOrg(resource.data);
    }


    match /eokulQueue/{queueId} {
      allow read:
        if isAdmin()
        && resource.data.organizationId ==
           currentUser().data.organizationId;

      allow create:
        if adminSameOrg(request.resource.data);

      allow update:
        if adminSameOrg(request.resource.data);

      allow delete:
        if adminSameOrg(resource.data);
    }


    match /dailyAttendance/{dailyAttendanceId} {
      allow get:
        if adminSameOrg(resource.data)
        || isParentOfStudent(resource.data.studentId);

      allow list:
        if adminSameOrg(resource.data)
        || isParentOfStudent(resource.data.studentId);

      allow create, update:
        if adminSameOrg(request.resource.data);

      allow delete:
        if adminSameOrg(resource.data);
    }


    match /dailyReports/{reportId} {
      allow read:
        if adminSameOrg(resource.data);

      allow create, update:
        if adminSameOrg(request.resource.data);

      allow delete:
        if adminSameOrg(resource.data);
    }


    match /notifications/{notificationId} {
      allow get:
        if adminSameOrg(resource.data)
        || (
          isParent()
          && resource.data.organizationId == currentUser().data.organizationId
          && resource.data.recipientUid == request.auth.uid
        );

      allow list:
        if adminSameOrg(resource.data)
        || (
          isParent()
          && resource.data.organizationId == currentUser().data.organizationId
          && resource.data.recipientUid == request.auth.uid
        );

      allow create:
        if adminSameOrg(request.resource.data);

      allow update:
        if adminSameOrg(request.resource.data);

      allow delete:
        if adminSameOrg(resource.data);
    }


    match /{document=**} {
      allow read, write: if false;
    }
  }
}
